# Server host and port
PPT_STUDIO_HOST=127.0.0.1
PPT_STUDIO_PORT=3101

# Optional UI API base override
VITE_API_BASE=/api

# Optional local agent command overrides
# If unset, Studio will try to auto-detect a local Codex-compatible command.
PPT_STUDIO_AGENT_PROVIDER=codex
PPT_STUDIO_AGENT_COMMAND=
PPT_STUDIO_AGENT_CWD=

# Optional Kimi (Moonshot) configuration
# Used when PPT_STUDIO_AGENT_PROVIDER=kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Optional prompt trace location
PPT_STUDIO_PROMPT_LOG_DIR=

# Optional logging
LOG_LEVEL=info

# Authentication notes:
# - Some local agent setups rely on `OPENAI_API_KEY`
# - Others rely on local CLI login such as `codex login`
OPENAI_API_KEY=
